# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 절대 git에 올리지 말 것)

# Discord 봇 토큰 (Discord Developer Portal > Bot > Reset Token)
# 비워두면 Discord 연동 없이 서버만 실행됨
DISCORD_BOT_TOKEN=

# 채팅을 가져올 채널 ID (쉼표로 여러 개 가능). 비워두면 봇이 볼 수 있는 모든 채널
# 채널 ID 복사: Discord 설정 > 고급 > 개발자 모드 ON 후 채널 우클릭 > "채널 ID 복사"
DISCORD_CHANNEL_IDS=

# 1 이면 테스트용 더미 채팅을 주기적으로 생성
DUMMY_CHAT=0

# 서버를 켤 때 켜 둘 채팅 출처 (discord, chzzk, dummy 중 쉼표로). 켠 뒤에는 관리 화면(http://localhost:8000)에서 바꿀 수 있음
CHAT_SOURCES=discord,chzzk

# 치지직 공식 Open API (치지직 개발자 센터에서 애플리케이션 등록 후 발급)
# 등록할 때 "로그인 리디렉션 URL" 에 아래 CHZZK_REDIRECT_URI 와 같은 값을 입력해야 함
# 스트림 키는 필요 없음 (절대 입력하지 말 것)
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_REDIRECT_URI=http://localhost:8000/chzzk/callback
