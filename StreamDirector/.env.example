# ⚠️ 비밀값 파일 - 절대 커밋/공유하지 마세요 (.gitignore 등록됨)

# Google AI Studio API 키 (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_EVENT_MODEL=gemini-2.5-flash-lite
GEMINI_MODERATION_MODEL=gemini-2.5-flash-lite
# live | mock | off  (키가 없으면 live 여도 규칙 기반 폴백으로 동작)
LLM_MODE=live

# 검열(전처리) 백엔드: local(기본, 무료·무제한) | gemini(무료 할당량 소모) | rules
MODERATION_BACKEND=local
TOXICITY_MODEL=smilegate-ai/kor_unsmile
TOXICITY_THRESHOLD=0.6
INTENT_CONFIDENCE=0.75
LOCAL_DEVICE=auto
# 로컬 LLM (애매한 문장 백그라운드 보정). 비우면 미사용
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma2:9b
OLLAMA_MODE=async

# Gemini 무료 할당량 보호 (이벤트 생성 전용). 초과 시 호출하지 않고 규칙 기반 이벤트로 대체
GEMINI_RPM_LIMIT=20
GEMINI_DAILY_LIMIT=800

# 치지직(CHZZK) Open API
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_REDIRECT_URI=http://localhost:8765/chzzk/callback
CHZZK_ACCESS_TOKEN=
CHZZK_REFRESH_TOKEN=

# 숲(SOOP) - 추후 입력
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=

# 디스코드 테스트 봇 (채팅 연동 + /후원 명령어)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=

# --- 선택 설정 (기본값) ---
# CHAT_WINDOW_SEC=2.0              # 첫 채팅 도착 후 윈도우 마감까지 시간
# EVENT_LLM_TIMEOUT_SEC=2.0
# MODERATION_LLM_TIMEOUT_SEC=1.2
# DONATION_VOTE_UNIT=1000          # 1000원당 투표 가중치 +1
# DONATION_INSTANT_THRESHOLD=10000 # 이 금액 이상은 즉시 발동
# EVENT_COOLDOWN_SEC=8
# MAX_EVENTS_PER_MINUTE=6
# MCP_HOST=127.0.0.1
# MCP_PORT=8765
# MODERATION_AGENT_URL=            # 예: http://127.0.0.1:8766/mcp (검열 에이전트 별도 프로세스)
# CORS_ORIGINS=*

# 디스코드 봇 실행 방식: standalone(별도 프로세스, 기본) | embedded(MCP 서버 안에서)
DISCORD_MODE=standalone
STREAMDIRECTOR_MCP_URL=http://127.0.0.1:8765/mcp
